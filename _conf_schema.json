{
  "enabled": {
    "description": "启用互动插件",
    "type": "bool",
    "default": true,
    "hint": "总开关。关闭后所有互动指令将不再响应。"
  },
  "currency_name": {
    "description": "积分名称",
    "type": "string",
    "default": "互动币",
    "hint": "签到、抽奖等玩法的货币名称，可自定义。"
  },
  "trigger": {
    "description": "触发方式",
    "type": "object",
    "hint": "控制群里的指令如何被触发。",
    "items": {
      "wake_free": {
        "description": "免 @ 直接触发",
        "type": "bool",
        "default": true,
        "hint": "开启后群里直接发「签到」「/签到」即可触发，无需 @机器人。"
      },
      "auto_regex_games": {
        "description": "游戏消息自动接管",
        "type": "bool",
        "default": true,
        "hint": "接龙、猜数字、数字炸弹等游戏进行中，无需任何前缀即可直接参与。"
      }
    }
  },
  "sign_in": {
    "description": "签到设置",
    "type": "object",
    "hint": "每日签到相关配置。",
    "items": {
      "enabled": {
        "description": "启用签到",
        "type": "bool",
        "default": true
      },
      "min_reward": {
        "description": "签到最少奖励",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 0,
          "max": 1000,
          "step": 1
        }
      },
      "max_reward": {
        "description": "签到最多奖励",
        "type": "int",
        "default": 50,
        "slider": {
          "min": 0,
          "max": 5000,
          "step": 1
        }
      },
      "streak_bonus": {
        "description": "连续签到加成系数",
        "type": "float",
        "default": 0.1,
        "hint": "每连续一天，奖励倍数 = 1 + 系数 × 连续天数，上限见 max_streak_bonus。",
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.05
        }
      },
      "max_streak_bonus": {
        "description": "连续签到奖励上限（倍数）",
        "type": "float",
        "default": 2.0,
        "slider": {
          "min": 1,
          "max": 10,
          "step": 0.5
        }
      }
    }
  },
  "lottery": {
    "description": "抽奖设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用抽奖",
        "type": "bool",
        "default": true
      },
      "cost": {
        "description": "单次消耗积分",
        "type": "int",
        "default": 20,
        "slider": {
          "min": 0,
          "max": 1000,
          "step": 1
        }
      },
      "cooldown_seconds": {
        "description": "冷却时间（秒）",
        "type": "int",
        "default": 30,
        "slider": {
          "min": 0,
          "max": 3600,
          "step": 5
        }
      }
    },
    "hint": "抽奖消耗积分。奖池期望值刻意略低于单次消耗，长期刷抽奖不会变成印钞机（默认 20 消耗对约 14 期望）。"
  },
  "guess_number": {
    "description": "猜数字设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用猜数字",
        "type": "bool",
        "default": true
      },
      "min": {
        "description": "数字最小值",
