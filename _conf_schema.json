  "auto_reply": {
    "description": "关键词互动回复",
    "type": "object",
    "hint": "当群消息命中关键词时自动回复，可配置多条规则。",
    "items": {
      "enabled": {
        "description": "启用关键词互动",
        "type": "bool",
        "default": false
      },
      "rules": {
        "description": "关键词规则列表",
        "type": "template_list",
        "default": [],
        "templates": {
          "rule": {
            "name": "规则",
            "items": {
              "keyword": {
                "description": "关键词",
                "type": "string",
                "default": ""
              },
              "reply": {
                "description": "回复内容",
                "type": "string",
                "default": ""
              },
              "exact": {
                "description": "是否精确匹配（完全相等）",
                "type": "bool",
                "default": false
              }
            }
          }
        }
      }
    }
  },
  "permission": {
    "description": "权限与限流",
